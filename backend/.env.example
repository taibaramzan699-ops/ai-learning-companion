ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# MongoDB Atlas connection string (from Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_learning_companion

# Path to the Firebase service account JSON (Firebase Console > Project Settings > Service Accounts > Generate new key)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=learning-companion

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Redis (rate limiting / caching)
REDIS_URL=redis://localhost:6379/0
